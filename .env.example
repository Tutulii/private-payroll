NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build
# Keep false until a live native-USDC STRK20 compatibility test succeeds.

# PostgreSQL stores encrypted vault records and non-sensitive workflow metadata.
DATABASE_URL=postgresql://payo:password@localhost:5432/payo
STARKNET_RPC_URL=https://your-server-side-mainnet-rpc
PAYO_WORKER_SECRET=generate-a-long-random-worker-secret

# Ready signs a one-time typed-data challenge. PAYO stores only a hash of the
# resulting revocable session token; the typed signature cannot move funds.
PAYO_AUTH_AUDIENCE=http://localhost:3000
PAYO_READY_SESSION_HOURS=12

# Proof-bound deployment. The browser and server seal addresses must match.
PAYO_CHAIN_ID=0x534e5f4d41494e
PAYO_SEAL_ADDRESS=
NEXT_PUBLIC_PAYO_SEAL_ADDRESS=
# Advanced v3 vesting transitions and the complete reporting-period accumulator.
PAYO_VESTING_BOOK_SEAL_ADDRESS=
NEXT_PUBLIC_PAYO_VESTING_BOOK_SEAL_ADDRESS=
# Registry values are duplicated deliberately: server routes fail closed when
# their private and browser-visible deployment addresses disagree.
PAYO_POLICY_REGISTRY_ADDRESS=
PAYO_OBLIGATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_PAYO_POLICY_REGISTRY_ADDRESS=
NEXT_PUBLIC_PAYO_OBLIGATION_REGISTRY_ADDRESS=

# Off by default in production. Temporarily enable only on the operator's local
# build when declaring/deploying the reviewed PAYO artifacts through Ready.
PAYO_ENABLE_DEPLOYMENT_OPERATOR=false

# Permissionless verifier transactions use a fee-funded relayer account. It
# never controls payroll funds. Store its private key in a production secret
# manager and never expose it through a NEXT_PUBLIC_ variable.
PAYO_PROOF_RELAYER_ADDRESS=
PAYO_PROOF_RELAYER_PRIVATE_KEY=

# Required only for the explicit relayer-account deployment command.
# PAYO_RELAYER_CONFIRM=DEPLOY_PAYO_RELAYER_MAINNET

# Required after PAYO contracts are deployed. The indexer resumes from its
# PostgreSQL cursor and rolls back non-canonical events on a reorg.
PAYO_INDEX_CHAIN_ID=SN_MAIN
PAYO_INDEX_CONSUMER=payo-seal
PAYO_INDEX_CONTRACT_ADDRESS=
PAYO_INDEX_FROM_BLOCK=
# First block of the deployed policy registry; required for historical FX renewal revocation checks.
PAYO_POLICY_REGISTRY_FROM_BLOCK=
PAYO_INDEX_BATCH_SIZE=100
PAYO_INDEX_FINALITY_LAG=2
PAYO_INDEX_PREFETCH_CONCURRENCY=4
PAYO_INDEX_MAX_REORG_DEPTH=128

# Server-side AEAD key for authoritative agent policies. Generate 32 random
# bytes, keep it in the production secret manager, and rotate with a rewrap job.
PAYO_CAPABILITY_ENCRYPTION_KEY=

# Phase 4 bounded autonomy is opt-in and belongs on a memory-sized executor,
# not on the public web machine. The relayer pays fees but cannot bypass the
# policy account; spend/view/session keys remain encrypted under the AEAD key.
PAYO_AGENT_EXECUTOR_ENABLED=false
PAYO_AGENT_WORKER_LIMIT=1
PAYO_AGENT_RELAYER_ADDRESS=
PAYO_AGENT_RELAYER_PRIVATE_KEY=
PAYO_AGENT_PROVER_URL=http://localhost:3000
PAYO_PRIVACY_KEY_ENCRYPTION_KEY=
PAYO_AGENT_POLICY_ACCOUNT_CLASS_HASH=
PAYO_AGENT_POLICY_ACCOUNT_ADDRESS=
NEXT_PUBLIC_PAYO_AGENT_POLICY_ACCOUNT_ADDRESS=
PAYO_POLICY_SIGNER_URL=http://payo-policy-signer.internal:3000
PAYO_POLICY_SIGNER_SECRET=
PAYO_POLICY_SIGNER_PUBLIC_KEY=
PAYO_POLICY_SIGNER_MAX_PROOF_ACTIONS=64
PAYO_POLICY_SIGNER_MAX_CREATED_NOTES=8
PAYO_POLICY_OWNER_PRIVATE_KEY=
PAYO_POLICY_OWNER_PUBLIC_KEY=
# Private treasury identity: web/worker secret store only; never the signer.
PAYO_AGENT_POLICY_VIEWING_KEY=
# Derived public identity: signer configuration only.
PAYO_AGENT_POLICY_VIEWING_PUBLIC_KEY=
PAYO_PHASE4_POLICY_OWNER_PUBLIC_KEY=
PAYO_POLICY_ROTATION_NEW_PUBLIC_KEY=
PAYO_POLICY_ROTATION_ACCEPTANCE_R=
PAYO_POLICY_ROTATION_ACCEPTANCE_S=
# One-time offline operator input; never set this on web, worker or signer apps.
PAYO_POLICY_ROTATION_CURRENT_PRIVATE_KEY=
PAYO_AGENT_SEAL_ADDRESS=
NEXT_PUBLIC_PAYO_AGENT_SEAL_ADDRESS=
PAYO_STRK20_POOL_ADDRESS=
# Block 5 private exit: address of a Mainnet instance whose on-chain class hash is
# exactly 0x2a4ac595283d4d64b9952f5ef5c0da1775bfdb7c9d92237524a21dd8d19ebd7.
# Leave empty to fail closed; declaration/deployment belongs to the release gate.
PAYO_EKUBO_ANONYMIZER_ADDRESS=
PAYO_AGENT_STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
PAYO_AGENT_USDC_TOKEN_ADDRESS=0x033068f6539f8e6e6b131e6b2b814e6c34a5224bc66947c47dab9dfee93b35fb

# Exact audited SDK build directory (0.14.3-rc.5 at the pinned PAYO revision).
# The runtime verifies package and executable digests before importing it.
PAYO_PRIVACY_SDK_ROOT=/absolute/path/to/starknet-privacy-sdk/sdk
# Devnet evidence only: audited PRIVACY-0.14.3-RC.0 pool build (class 0x52107f…).
PAYO_PRIVACY_POOL_SIERRA=/absolute/path/to/privacy_Privacy.contract_class.json
PAYO_PRIVACY_POOL_CASM=/absolute/path/to/privacy_Privacy.compiled_contract_class.json
PAYO_PRIVACY_POOL_SOURCE_ROOT=/absolute/path/to/starknet-privacy/packages/privacy
PAYO_STRK20_PROVING_URL=
PAYO_STRK20_INDEXER_URL=
PAYO_STRK20_INDEXER_MAX_LAG_SECONDS=120
PAYO_AGENT_FINALITY_BLOCKS=3

# MCP receives the ciphertext-only application URL and a scoped PAYO API token.
PAYO_API_URL=http://localhost:3000
PAYO_API_ACCESS_TOKEN=
PAYO_CAPABILITY_ID=
PAYO_CAPABILITY_ISSUER_PUBLIC_KEY=
