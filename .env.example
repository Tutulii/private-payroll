NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build
# Keep false until a live native-USDC STRK20 compatibility test succeeds.
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_USDC=false

# Server-only Privy features may use PRIVY_APP_SECRET.
# Never prefix the secret with NEXT_PUBLIC_ and never commit a real value.
PRIVY_APP_SECRET=your-rotated-server-only-secret

# PostgreSQL stores encrypted vault records and non-sensitive workflow metadata.
DATABASE_URL=postgresql://payo:password@localhost:5432/payo

# Optional: avoids a Privy verification-key lookup on the first API request.
PRIVY_JWT_VERIFICATION_KEY=

# MCP receives the ciphertext-only application URL and a short-lived Privy token.
PAYO_API_URL=http://localhost:3000
PAYO_API_ACCESS_TOKEN=
PAYO_CAPABILITY_ID=
PAYO_CAPABILITY_ISSUER_PUBLIC_KEY=
