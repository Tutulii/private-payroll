NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build
# Keep false until a live native-USDC STRK20 compatibility test succeeds.

# PostgreSQL stores encrypted vault records and non-sensitive workflow metadata.
DATABASE_URL=postgresql://payo:password@localhost:5432/payo
STARKNET_RPC_URL=https://your-server-side-mainnet-rpc
PAYO_WORKER_SECRET=generate-a-long-random-worker-secret

# Ready signs a one-time typed-data challenge. PAYO stores only a hash of the
# resulting revocable session token; the typed signature cannot move funds.
PAYO_AUTH_AUDIENCE=http://localhost:3000
PAYO_READY_SESSION_HOURS=12

# Proof-bound deployment. The browser and server seal addresses must match.
PAYO_CHAIN_ID=0x534e5f4d41494e
PAYO_SEAL_ADDRESS=
NEXT_PUBLIC_PAYO_SEAL_ADDRESS=
# Registry values are duplicated deliberately: server routes fail closed when
# their private and browser-visible deployment addresses disagree.
PAYO_POLICY_REGISTRY_ADDRESS=
PAYO_OBLIGATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_PAYO_POLICY_REGISTRY_ADDRESS=
NEXT_PUBLIC_PAYO_OBLIGATION_REGISTRY_ADDRESS=

# Off by default in production. Temporarily enable only on the operator's local
# build when declaring/deploying the reviewed PAYO artifacts through Ready.
PAYO_ENABLE_DEPLOYMENT_OPERATOR=false

# Permissionless verifier transactions use a fee-funded relayer account. It
# never controls payroll funds. Store its private key in a production secret
# manager and never expose it through a NEXT_PUBLIC_ variable.
PAYO_PROOF_RELAYER_ADDRESS=
PAYO_PROOF_RELAYER_PRIVATE_KEY=

# Required only for the explicit relayer-account deployment command.
# PAYO_RELAYER_CONFIRM=DEPLOY_PAYO_RELAYER_MAINNET

# Required after PAYO contracts are deployed. The indexer resumes from its
# PostgreSQL cursor and rolls back non-canonical events on a reorg.
PAYO_INDEX_CHAIN_ID=SN_MAIN
PAYO_INDEX_CONSUMER=payo-seal
PAYO_INDEX_CONTRACT_ADDRESS=
PAYO_INDEX_FROM_BLOCK=
# First block of the deployed policy registry; required for historical FX renewal revocation checks.
PAYO_POLICY_REGISTRY_FROM_BLOCK=
PAYO_INDEX_BATCH_SIZE=100
PAYO_INDEX_FINALITY_LAG=2
PAYO_INDEX_PREFETCH_CONCURRENCY=4
PAYO_INDEX_MAX_REORG_DEPTH=128

# MCP receives the ciphertext-only application URL and a scoped PAYO API token.
PAYO_API_URL=http://localhost:3000
PAYO_API_ACCESS_TOKEN=
PAYO_CAPABILITY_ID=
PAYO_CAPABILITY_ISSUER_PUBLIC_KEY=
